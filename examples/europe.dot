// The railways of Europe as a line map: 242 cities pinned on a grid close to where they lie, and
// 132 long-distance routes, real or nearly so, each its own line. The big example for testing the
// studio's speed: everything is pinned, there are no containers, and the router finds all 355
// routes between the pins. Brig, where the Simplon, the Lötschberg and the Glacier Express
// cross, sits south-west of the middle.
digraph europe {
  subgraph lines {                               // order = lane order in every bundle
    ES1  [label="Eurostar London to Amsterdam",         color="#a51d1d"]
    ES2  [label="Eurostar London to Paris",             color="#26d95a"]
    NOR  [label="Nord Express",                         color="#7d22bf"]
    MED  [label="Paris to the Côte d'Azur",             color="#a5941d"]
    SUD  [label="Sud Express",                          color="#26bbd9"]
    BRE  [label="Bretagne",                             color="#bf2277"]
    LOI  [label="Normandie to the Loire",               color="#3fa51d"]
    EST  [label="Magistrale Paris to München",          color="#2e26d9"]
    CAP  [label="Le Capitole",                          color="#bf5622"]
    GSU  [label="Grand Sud",                            color="#1da572"]
    FRE  [label="Fréjus",                               color="#ca26d9"]
    SIM  [label="Simplon-Orient",                       color="#9ebf22"]
