  "keywords": [
    "flowchart",
    "diagram",
    "transit-map",
    "metro-map",
    "dot",
    "graphviz",
    "svg"
  ],
  "license": "MPL-2.0",
  "homepage": "https://github.com/mergezalot/linemap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mergezalot/linemap.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/mergezalot/linemap/issues",
  "type": "module",
  "bin": {
    "linemap": "cli.mjs"
  },
  "files": [
    "cli.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
