{
  "name": "@linemap/studio",
  "version": "0.2.0",
  "description": "The linemap studio as one self-contained HTML file, and the few lines that bake DOT flows into it. The CLI (`linemap export`, `linemap studio`) uses this.",
  "keywords": [
    "flowchart",
    "diagram",
    "transit-map",
    "metro-map",
    "dot",
    "graphviz",
    "svg",
    "html"
  ],
  "license": "MPL-2.0",
  "homepage": "https://github.com/mergezalot/linemap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mergezalot/linemap.git",
    "directory": "packages/studio"
  },
  "bugs": "https://github.com/mergezalot/linemap/issues",
  "type": "module",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "serve.mjs",
    "dist/linemap.html"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node test/smoke.mjs",
    "prepack": "node build.mjs && node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "devDependencies": {
    "@linemap/core": "workspace:*",
    "esbuild": "0.28.2",
    "playwright": "1.65.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
