{
  "name": "linemap-workspace",
  "private": true,
  "description": "Flow diagrams with pinned nodes and transit-map style line bundles, exported as SVG or one self-contained HTML file.",
  "license": "MPL-2.0",
  "homepage": "https://github.com/mergezalot/linemap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mergezalot/linemap.git"
  },
  "bugs": "https://github.com/mergezalot/linemap/issues",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "example": "node scripts/examples.mjs",
    "build": "pnpm --filter @linemap/studio build",
    "export": "node packages/cli/cli.mjs export",
    "studio": "node packages/studio/build.mjs --serve",
    "test": "pnpm build && pnpm --filter @linemap/core test && pnpm --filter @linemap/cli test",
    "test:studio": "pnpm --filter @linemap/studio test",
    "pack-check": "node scripts/pack-check.mjs",
    "release": "scripts/release.sh"
  }
}
